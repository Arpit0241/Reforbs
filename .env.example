# ==============================================================================
# Reforbs Living - Production Environment Variables Template (Vercel)
# ==============================================================================
# IMPORTANT:
# 1. Never commit real .env / .env.local files.
# 2. Configure these variables in Vercel -> Project Settings -> Environment Variables.
# ==============================================================================

# [SERVER-ONLY SECRET] Google Apps Script Web App URL for lead / schedule-visit form sync
# Used server-side only in src/app/api/lead/route.ts
GOOGLE_SHEETS_WEBHOOK_URL=

# [PUBLIC BROWSER KEY - OPTIONAL] CARTO Voyager Basemaps API Key
# Restrict HTTP Referrer in CARTO to https://reforbs.com/* and https://www.reforbs.com/*
# If omitted, PropertyMap.tsx automatically falls back to standard OpenStreetMap HTTPS tiles.
NEXT_PUBLIC_CARTO_API_KEY=

# ==============================================================================
# SEO, Domain Canonicalization & Analytics
# ==============================================================================
# Canonical production origin (no trailing slash).
# Setting this to https://reforbs.com on Vercel Production activates the 301
# canonical redirects from www.reforbs.com and *.vercel.app to https://reforbs.com.
# Leave unset in Vercel until reforbs.com shows Valid Configuration.
NEXT_PUBLIC_SITE_URL=https://reforbs.com

# Search engine verification tokens
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Optional GA4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional IndexNow key (32 hex chars matching /public/<key>.txt)
INDEXNOW_KEY=
